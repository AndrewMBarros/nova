# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).

COMPANY_NAME=Sua Empresa

# dev = liga as rotas /dev/* (simulador, SEM autenticação). Use só na sua máquina.
# Em servidor, deixe ENVIRONMENT=prod (padrão).
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./nova.db

# console | imap_readonly | imap | graph_readonly | graph
MAIL_MODE=console
NOVA_EMAIL=
TEAM_EMAIL=

# IMAP/SMTP (Gmail): use uma SENHA DE APLICATIVO, nunca a senha normal
MAIL_USERNAME=
MAIL_PASSWORD=
FROM_NAME=
REPLY_TO=

# Microsoft Graph (opcional)
MICROSOFT_AUTH_MODE=delegated
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=

# Campos fixos do pré-atendimento (abertura de chamado no ERP)
TICKET_TYPE=Suporte Técnico
TICKET_CHANNEL=E-mail
TICKET_ACCESS_TYPE=Remoto

# Piloto / regras
PROCESS_FROM=
ONLY_SENDERS=
TEAM_SENDERS=
BLOCKED_SUBJECTS=
